{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "rules": {
    "prefer-const": "error",
    "no-var": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true,
        "ignoreMemberSort": false
      }
    ],
    "vite-plus/prefer-vite-plus-imports": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "jsPlugins": [
    {
      "name": "vite-plus",
      "specifier": "vite-plus/oxlint-plugin"
    }
  ]
}
