{
  "name": "vsstubs",
  "displayName": "VapourSynth Stubs",
  "version": "0.3.1",
  "description": "Generate typing stubs for VapourSynth plugins",
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "autocompletion",
    "python",
    "stubs",
    "typing",
    "vapoursynth"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ichunjo/vs-stubs"
  },
  "publisher": "vd-varde",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && npm run lint && rolldown -c",
    "format": "vp fmt --write \"**/*.{ts,mts,json,yml,html,css}\"",
    "lint": "vp lint src",
    "package": "npm run check-types && npm run lint && rolldown -c --minify",
    "vscode:prepublish": "npm run package",
    "watch": "npm-run-all -p watch:*",
    "watch:rolldown": "rolldown -c --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json"
  },
  "dependencies": {
    "@vscode/python-extension": "1.0.6",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/semver": "7.8.0",
    "@types/vscode": "1.136.0",
    "npm-run-all2": "9.0.3",
    "rolldown": "1.2.8",
    "typescript": "7.0.2",
    "vite-plus": "0.3.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "vsstubs.generate",
        "title": "VapourSynth: Generate Stubs"
      },
      {
        "command": "vsstubs.addPlugin",
        "title": "VapourSynth: Add Plugin Stubs"
      },
      {
        "command": "vsstubs.removePlugin",
        "title": "VapourSynth: Remove Plugin Stubs"
      },
      {
        "command": "vsstubs.update",
        "title": "VapourSynth: Update Stubs"
      },
      {
        "command": "vsstubs.check",
        "title": "VapourSynth: Check Stubs"
      }
    ],
    "configuration": {
      "title": "VapourSynth Stubs",
      "properties": {
        "vsstubs.autoGenerate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically generate stubs when the workspace is opened."
        },
        "vsstubs.extraPluginDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional directories to load plugins from. Each path is passed as `--load` to the `vsstubs` CLI."
        },
        "vsstubs.enableCompatApi3": {
          "type": "boolean",
          "default": false,
          "description": "Enable return type compatibility for APIv3 plugins."
        },
        "vsstubs.watchPlugins": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Watch VapourSynth plugin directories for changes and automatically regenerate stubs when plugins are added, updated, or removed."
        },
        "vsstubs.watchDebounceTime": {
          "type": "number",
          "default": 3000,
          "description": "Delay (in milliseconds) between the last plugin change detected and the stub regeneration."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:python",
    "workspaceContains:**/*.vpy"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.130.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  }
}
