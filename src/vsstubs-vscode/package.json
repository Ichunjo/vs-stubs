{
  "name": "vsstubs",
  "displayName": "VapourSynth Stubs",
  "version": "0.5.0",
  "description": "Generate typing stubs for VapourSynth plugins",
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "autocompletion",
    "python",
    "stubs",
    "typing",
    "vapoursynth"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ichunjo/vs-stubs"
  },
  "publisher": "vd-varde",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "compile": "vp check && vp pack",
    "package": "vp check && vp pack --minify",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test --run",
    "test:coverage": "vp test --run --coverage",
    "vscode:prepublish": "vp run package",
    "watch": "vp pack --watch"
  },
  "dependencies": {
    "@vscode/python-extension": "1.0.6",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "@types/vscode": "1.90.0",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "vsstubs.generate",
        "title": "VapourSynth: Generate Stubs"
      },
      {
        "command": "vsstubs.addPlugin",
        "title": "VapourSynth: Add Plugin Stubs"
      },
      {
        "command": "vsstubs.removePlugin",
        "title": "VapourSynth: Remove Plugin Stubs"
      },
      {
        "command": "vsstubs.update",
        "title": "VapourSynth: Update Stubs"
      },
      {
        "command": "vsstubs.check",
        "title": "VapourSynth: Check Stubs"
      }
    ],
    "configuration": {
      "title": "VapourSynth Stubs",
      "properties": {
        "vsstubs.autoGenerate": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Automatically generate stubs when the workspace is opened."
        },
        "vsstubs.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Check for plugin updates or missing signatures when the workspace is opened."
        },
        "vsstubs.extraPluginDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Additional directories to load plugins from. Each path is passed as `--load` to the `vsstubs` CLI."
        },
        "vsstubs.promptOnPluginChanges": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show a prompt to regenerate stubs when new, removed, or modified plugins are detected."
        },
        "vsstubs.showUpToDateNotification": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show an informational notification when manual check confirms stubs are already up to date."
        },
        "vsstubs.watchPlugins": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Watch VapourSynth plugin directories for changes and automatically regenerate stubs when plugins are added, updated, or removed."
        },
        "vsstubs.watchDebounceTime": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "scope": "resource",
          "description": "Delay (in milliseconds) between the last plugin change detected and the stub regeneration."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:python",
    "workspaceContains:**/*.vpy"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "icon": "resources/icon.png",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "download"
    }
  },
  "engines": {
    "vscode": "^1.90.0"
  }
}
